# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://goldribbon.example

# --- The chain ----------------------------------------------------------
# All three are unset until deployment. With any of them missing the site
# states that nothing is live, disables the release button and shows an empty
# ledger. There is no demo mode and no seeded donation figure.
NEXT_PUBLIC_GOLDRIBBON_TOKEN_ADDRESS=
NEXT_PUBLIC_GOLDRIBBON_VAULT_ADDRESS=
# The charity's own receiving address, burned into the vault at deploy time.
# MUST be an address the charity controls ON THE DEPLOYMENT CHAIN (Base by
# default) and has confirmed in writing. A mainnet-only custodial address
# reused on Base can strand every donation permanently.
NEXT_PUBLIC_GOLDRIBBON_RECIPIENT_ADDRESS=
# Needs to be true AND a vault AND a recipient before any present-tense claim
# appears on the page.
NEXT_PUBLIC_GOLDRIBBON_LIVE=false

# Optional private RPC. Falls back to the public Base endpoint.
NEXT_PUBLIC_RPC_URL=

# --- The agreement ------------------------------------------------------
# Do not flip this on the strength of an email. It means a signed document
# exists permitting the charity to be named as the beneficiary. Until then the
# site lists candidates and states that none has agreed to anything.
NEXT_PUBLIC_GOLDRIBBON_AGREEMENT_SIGNED=false
# Must match a `name` in src/lib/recipient.ts exactly.
NEXT_PUBLIC_GOLDRIBBON_RECIPIENT_NAME=
# Public URL of the charity's acknowledgement, once there is one.
NEXT_PUBLIC_GOLDRIBBON_ACKNOWLEDGEMENT_URL=

# --- Contact ------------------------------------------------------------
# A named, reachable operator is a launch requirement, not a nice-to-have.
NEXT_PUBLIC_GOLDRIBBON_CONTACT=
NEXT_PUBLIC_GOLDRIBBON_X=
